# Copy to .env.local and fill. Never paste values into chat.

# ===== MUST (one of each, or that agent stays on fixtures) =====

# Gemini — supervisor routing + interview scoring
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# GitHub — PAT classic: repo + issues. OWNER = your username OR an org you already own.
# We can create team repos under OWNER. We cannot create a new GitHub Organization via API.
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=
# Seed repos to assess (create these once, or let the agent create them later)
GITHUB_REPOS=team-healthy,team-stalled,team-noisy
# Hours without a commit before a team is stalled (default 5)
GITHUB_STALL_HOURS=5

# Discord — bot in ONE server. Bot can create channels. You do not need to pre-make team rooms.
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Public key from the Discord app General Information page. Needed for /status.
# Also set Interactions Endpoint URL to https://YOUR-NGROK-HOST/api/discord/interactions
# Start the tunnel with: npm run tunnel  (needs ngrok + `npm run dev`)
DISCORD_PUBLIC_KEY=

# Eventbrite — private token + organization id (needed to CREATE events via API).
# Event id is optional if the Registration agent creates the event for you.
# https://www.eventbrite.com/platform/api-keys
EVENTBRITE_TOKEN=
EVENTBRITE_ORGANIZATION_ID=
EVENTBRITE_EVENT_ID=

# ===== OPTIONAL (agent can create these; paste IDs if you already made them) =====

DISCORD_ONBOARDING_CHANNEL_ID=
DISCORD_ALERTS_CHANNEL_ID=
DISCORD_MENTORS_CHANNEL_ID=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
DISCORD_HACKER_ROLE_ID=
DISCORD_STALLED_ROLE_ID=
DISCORD_INVITE_URL=

# ===== LATER (welcome email / Meet fallback) =====

RESEND_API_KEY=
# Free / demo: Hackerman <onboarding@resend.dev> (Resend only delivers to RESEND_TEST_TO).
# After the hackathon, switch FROM to an address on a verified domain.
RESEND_FROM=Hackerman <onboarding@resend.dev>
# Inbox tied to the Resend account — required while using onboarding@resend.dev
RESEND_TEST_TO=
MEET_FALLBACK_URL=

# ===== OPTIONAL observability (dashboard still shows local agent traces without these) =====
# Free tier: only the supervisor routing trace is sent to Langfuse. Worker/tool runs stay local.
# https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
